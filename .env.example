# MCP Server Configuration (with mTLS support)
PG_MCP_URL=https://localhost:8443/sse
# For development without TLS, use: PG_MCP_URL=http://localhost:8000/sse and set ENABLE_TLS=false

# TLS/mTLS Configuration
ENABLE_TLS=true

# Database Configuration
DATABASE_URL=postgresql://user:password@hostname:port/databasename

# API Keys
ANTHROPIC_API_KEY=Your Anthropic API key goes here

# Biscuit Token Configuration (generate using utilities/biscuit_generator.py)
BISCUIT_TOKEN=your generated biscuit token goes here
BISCUIT_PUBLIC_KEY=your generated biscuit public key goes here
